{
  "data": {
    "era5_path": "datasets/era5_global_0p25_6h.zarr",
    "ztd_path": "datasets/global_ngl_0p25_5min_2023_2025.zarr",
    "conds_path": "model/conds.npy",
    "global_lat_path": "test_data/latitude_era5.npy",
    "global_lon_path": "test_data/longitude_era5.npy",
    "mean_std_dir": "/inspire/ssd/project/sais-weather/public/fuxi-obs/obs-grid-qc_new/mean_std",
    "obs_history_hours": 6,
    "obs_interval_minutes": 20,
    "train_split": ["2023-01-01T00:00:00", "2024-05-01T00:00:00"],
    "val_split": ["2024-05-01T00:00:00", "2025-01-01T00:00:00"],
    "test_split": ["2025-01-01T00:00:00", "2026-01-01T00:00:00"]
  },
  "model": {
    "image_size": [720, 1440],
    "era5_channels": 70,
    "era5_frames": 2,
    "era_static_channels": 5,
    "obs_static_channels": 3,
    "out_channels": 70,
    "embed_dim": 1536,
    "patch_size": 4,
    "window_size": 9,
    "depths": [12, 12, 12, 12],
    "num_heads": 24,
    "mlp_ratio": 4.0,
    "time_dim": 12,
    "use_obs": true
  },
  "train": {
    "seed": 2000,
    "epochs": 40,
    "batch_size_per_gpu": 4,
    "gradient_accumulation": 4,
    "num_workers": 4,
    "learning_rate": 0.0002,
    "min_learning_rate": 0.000001,
    "weight_decay": 0.05,
    "warmup_steps": 100,
    "gradient_clip": 1.0,
    "log_interval": 20,
    "loss_mode": "global_only",
    "freeze_fuxi": true,
    "halo_weight": 0.5,
    "halo_radius": 3,
    "amp": "bf16",
    "output_dir": "work_dirs/da_forecast_global_6h_fsdp_train-obs",
    "fsdp": {
      "enabled": true,
      "sync_module_states": true,
      "forward_prefetch": true,
      "limit_all_gathers": true,
      "use_orig_params": true
    }
  }
}
