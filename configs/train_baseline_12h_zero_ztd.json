{
  "data": {
    "era5_path": "datasets/era5_global_0p25_6h.zarr",
    "ztd_path": "datasets/global_ngl_0p25_5min_2023_2025.zarr",
    "conds_path": "model/conds.npy",
    "global_lat_path": "test_data/latitude_era5.npy",
    "global_lon_path": "test_data/longitude_era5.npy",
    "mean_std_dir": "/inspire/ssd/project/sais-weather/public/fuxi-obs/obs-grid-qc_new/mean_std",
    "obs_history_hours": 6,
    "obs_interval_minutes": 20,
    "train_split": [
      "2023-01-01T00:00:00",
      "2024-05-01T00:00:00"
    ],
    "val_split": [
      "2024-05-01T00:00:00",
      "2025-01-01T00:00:00"
    ],
    "test_split": [
      "2025-01-01T00:00:00",
      "2026-01-01T00:00:00"
    ],
    "forecast_lead_hours": 12,
    "rollout_zarr": "datasets/era5_rollout12h_baseline_zero_ztd.zarr",
    "rollout_source_checkpoint": "work_dirs/da_forecast_global_6h_fsdp_train_obs-bs2_zero-ztd/best.pt",
    "rollout_source_observations": "zero_ztd_history_at_T"
  },
  "model": {
    "image_size": [
      720,
      1440
    ],
    "era5_channels": 70,
    "era5_frames": 2,
