{
  "data": {
    "era5_path": "datasets/era5_global_0p25_6h.zarr",
    "ztd_path": "datasets/global_ngl_0p25_5min_2023_2025.zarr",
    "conds_path": "model/conds.npy",
    "global_lat_path": "test_data/latitude_era5.npy",
    "global_lon_path": "test_data/longitude_era5.npy",
    "mean_std_dir": "/inspire/ssd/project/sais-weather/public/fuxi-obs/obs-grid-qc_new/mean_std",
    "obs_history_hours": 6,
    "obs_interval_minutes": 20,
    "train_split": [
      "2023-01-01T00:00:00",
      "2024-05-01T00:00:00"
    ],
    "val_split": [
      "2024-05-01T00:00:00",
      "2025-01-01T00:00:00"
    ],
    "test_split": [
      "2025-01-01T00:00:00",
      "2026-01-01T00:00:00"
    ]
  },
  "model": {
    "image_size": [
      720,
      1440
    ],
    "era5_channels": 70,
    "era5_frames": 2,
    "era_static_channels": 5,
    "obs_static_channels": 3,
    "out_channels": 70,
    "embed_dim": 1536,
    "patch_size": 4,
    "window_size": 9,
    "depths": [
      12,
      12,
      12,
      12
    ],
    "num_heads": 24,
    "mlp_ratio": 4,
    "time_dim": 12,
    "use_obs": true,
    "zero_ztd": false,
    "obs_channels": 2
  },
  "train": {
    "seed": 2000,
    "batch_size_per_gpu": 1,
    "gradient_accumulation": 8,
    "num_workers": 1,
    "learning_rate": 0.00001,
    "min_learning_rate": 0.000001,
    "weight_decay": 0.05,
    "warmup_steps": 25,
    "gradient_clip": 1,
    "log_interval": 10,
    "loss_mode": "global_only",
    "freeze_fuxi": false,
    "freeze_obs": false,
    "halo_weight": 0.5,
    "halo_radius": 3,
    "amp": "bf16",
    "output_dir": "work_dirs/da_forecast_rollout48h_zhd_zwd",
    "fsdp": {
      "enabled": true,
      "sync_module_states": true,
      "forward_prefetch": false,
      "limit_all_gathers": true,
      "use_orig_params": true
    },
    "rollout_checkpoint": true,
    "validate_every": 500,
    "save_every": 100,
    "val_batch_size": 1
  },
  "initial_checkpoint": "work_dirs/da_forecast_stage2_finetune_fuxi/best.pt",
  "curriculum": {
    "max_steps": 8,
    "updates_per_stage": 500,
    "observation_policy": "origin_only",
    "loss_aggregation": "mean_all_active_leads"
  }
}
